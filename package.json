{
  "name": "brainadz-hrms",
  "version": "1.0.0",
  "description": "BrainADZ HRMS - people operations across BrainADZ Live, Marketing and Exhibits",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.js\"",
    "reset-demo": "node --disable-warning=ExperimentalWarning server/reset.js",
    "build:demo": "vite build --config demo/vite.config.js && node demo/inline.js",
    "format": "prettier --write \"**/*.{js,jsx,mjs,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,css,html}\"",
    "hos:dev": "node hospitality/scripts/dev.js",
    "hos:build": "vite build --config hospitality/client/vite.config.js",
    "hos:start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning hospitality/server/index.js",
    "hos:test": "node --disable-warning=ExperimentalWarning --test \"hospitality/tests/*.test.js\"",
    "hos:e2e": "node --disable-warning=ExperimentalWarning hospitality/tests/e2e/run.mjs",
    "hos:reset": "node --disable-warning=ExperimentalWarning hospitality/server/reset.js",
    "test:all": "npm test && npm run hos:test",
    "hos:web": "node --disable-warning=ExperimentalWarning hospitality/web/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/inter": "5.3.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "unpdf": "^1.8.1",
    "vite": "^6.4.4"
  },
  "devDependencies": {
    "@noble/hashes": "1.5.0",
    "buffer": "6.0.3",
    "prettier": "^3.9.10",
    "sql.js": "1.12.0"
  }
}
