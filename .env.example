# Copy this file to ".env" and fill it in. Never share or commit your .env file.

# ---- About you -------------------------------------------------------------
# Starting values for the Settings page (you can change them in the app later).
BUSINESS_NAME=My Business
OWNER_EMAIL=you@example.com
DEFAULT_CURRENCY=USD

# ---- When reminders go out ------------------------------------------------
# Your time zone, e.g. Asia/Kolkata, Europe/London, America/New_York
APP_TIMEZONE=Asia/Kolkata
# Daily time (24-hour clock) to check for renewals and send reminder emails
REMINDER_TIME=09:00

# ---- Email sending (SMTP) -------------------------------------------------
# Gmail:   SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  (use an App Password, see README)
# Outlook: SMTP_HOST=smtp.office365.com SMTP_PORT=587
# Zoho:    SMTP_HOST=smtp.zoho.com      SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
# The address reminder emails are sent from (usually the same as SMTP_USER)
MAIL_FROM=you@gmail.com

# ---- App ------------------------------------------------------------------
PORT=3000
# Password to open the app (username can be anything, e.g. "admin").
# Strongly recommended if the app is reachable from the internet.
APP_PASSWORD=
# Public address of the app; adds an "Open Subscription Manager" button to your reminder emails
APP_URL=http://localhost:3000
# Where data is stored
DATABASE_PATH=data/subscriptions.db
