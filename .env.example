# Copy to .env (or set these in your hosting provider's dashboard).

# Port the server listens on.
PORT=3000

# Where the database (hrms.db) and uploaded files are stored. Back this folder up.
DATA_DIR=./data

# "demo" (default) loads the fictional demo company on first start.
# "empty" starts with only an administrator account.
SEED=demo
ADMIN_EMAIL=admin@brainadz.com
ADMIN_PASSWORD=

# Claude for the Resume Screener and "Ask AI". Leave empty for rule-based scoring.
ANTHROPIC_API_KEY=
# HRMS_AI_MODEL=claude-opus-5-5

# Set both when the app is served over HTTPS behind a proxy (Render, Railway, Nginx).
TRUST_PROXY=1
COOKIE_SECURE=true

# Google Play Store app (optional, see README "Put it in the Google Play Store").
# The app's package ID, and its signing key's SHA-256 fingerprint(s), comma separated.
ANDROID_PACKAGE=
ANDROID_CERT_SHA256=

# One sign-in with BrainADZ Projects (optional, see README "One sign-in for HRMS and Projects").
# The Projects address, and a secret of 32+ characters set to the same value in Projects.
PROJECTS_URL=
SSO_SECRET=

# BrainADZ CRM address (optional): adds a CRM tile to the app picker. The CRM keeps its own sign-in.
CRM_URL=
