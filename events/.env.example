# Copy to .env (or set these in your hosting provider's dashboard).
PORT=3100
DATA_DIR=./data

# "demo" (default) loads FutureWorks Expo on first start. "empty" starts with one organiser.
SEED=demo
ORGANISER_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address used in emailed links, e.g. https://events.example.com
PUBLIC_URL=
# Set both when served over HTTPS behind a proxy.
TRUST_PROXY=
COOKIE_SECURE=

# Email: "local" (default, nothing is delivered) or "smtp".
EMAIL_ADAPTER=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Payments: "local" (default, no money moves) or "razorpay".
PAYMENT_ADAPTER=local
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Badge printing: "local" (default, nothing is printed) or "station" (Windows print stations).
PRINTER_ADAPTER=local

# Push notifications (optional).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=
APNS_BUNDLE_ID=com.brainadz.events
APNS_ENV=sandbox
FCM_SERVICE_ACCOUNT_FILE=

# App-link verification (optional).
IOS_APP_ID=
ANDROID_PACKAGE=com.brainadz.events
ANDROID_CERT_SHA256=
